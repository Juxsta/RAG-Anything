# Development Dockerfile for RAG-Anything API Server

FROM node:20-alpine

# Install Python and system dependencies
RUN apk add --no-cache \
    python3 \
    python3-dev \
    py3-pip \
    gcc \
    musl-dev \
    postgresql-dev \
    libffi-dev \
    openssl-dev \
    curl \
    bash \
    && ln -sf python3 /usr/bin/python

# Create Python virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python packages
RUN pip install --upgrade pip && \
    pip install raganything

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S ragapi -u 1001 -G nodejs

WORKDIR /app

# Copy package files and install Node.js dependencies
COPY --chown=ragapi:nodejs package*.json ./
COPY --chown=ragapi:nodejs tsconfig.json ./
RUN npm install

# Create necessary directories
RUN mkdir -p src scripts logs temp uploads rag_storage output && \
    chown -R ragapi:nodejs .

# Set Python environment
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1

# Install development tools globally
RUN npm install -g nodemon tsx

# Switch to non-root user
USER ragapi

# Expose ports
EXPOSE 3000 9229

# Development command with hot reload
CMD ["npm", "run", "dev"]