# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/rag_anything_api
DATABASE_MAX_CONNECTIONS=20

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=rag-api:

# Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ISSUER=rag-anything-api
JWT_AUDIENCE=rag-anything-clients
API_KEY_SALT=your-api-key-salt-16chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_MAX_FILES=100
TEMP_DIR=./temp
CLEANUP_INTERVAL_MS=3600000

# Python Integration
PYTHON_EXECUTABLE=python3
PYTHON_WORKER_SCRIPT=../scripts/python_worker.py
PYTHON_PROCESS_TIMEOUT=1800000
PYTHON_MAX_PROCESSES=4

# RAG-Anything Configuration
RAG_STORAGE_DIR=./rag_storage
RAG_OUTPUT_DIR=./output

# Monitoring
PROMETHEUS_METRICS_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000

# External Service API Keys (Optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS Origins (Production)
CORS_ORIGINS=https://app.rag-anything.com,https://admin.rag-anything.com

# Additional Environment Variables (Optional)
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# NEW_RELIC_LICENSE_KEY=your-new-relic-key
# SWAGGER_UI_ENABLED=true
# API_DOCS_PATH=/docs