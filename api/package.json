{
  "name": "rag-anything-api",
  "version": "1.0.0",
  "description": "REST API server for RAG-Anything multimodal document processing and retrieval system",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:e2e:playwright": "playwright test",
    "test:security": "jest --testPathPattern=security",
    "test:performance": "artillery run tests/performance/artillery-config.yml",
    "test:load": "k6 run tests/performance/load-test.js",
    "test:all": "npm run test && npm run test:e2e && npm run test:security",
    "test:ci": "npm run test:coverage && npm run test:e2e && npm run test:security && npm run test:performance",
    "lint": "eslint src --ext .ts,.js --fix",
    "lint:check": "eslint src --ext .ts,.js",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "format:check": "prettier --check src/**/*.{ts,js,json}",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage test-results",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "docker:build": "docker build -t rag-anything-api .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docs:generate": "tsx scripts/generate-openapi.ts"
  },
  "keywords": [
    "rag",
    "multimodal",
    "document-processing",
    "api",
    "fastify",
    "typescript",
    "ai",
    "ml"
  ],
  "author": "RAG-Anything Team",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.24.3",
    "@fastify/autoload": "^5.8.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@fastify/type-provider-typebox": "^3.5.0",
    "@sinclair/typebox": "^0.31.28",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "bullmq": "^4.15.4",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "socket.io": "^4.7.4",
    "msgpack5": "^6.0.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prom-client": "^15.0.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "mime-types": "^2.1.35",
    "sharp": "^0.32.6",
    "file-type": "^19.0.0",
    "archiver": "^6.0.1",
    "yauzl": "^3.0.0",
    "node-cron": "^3.0.3",
    "pidusage": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/archiver": "^6.0.2",
    "@types/yauzl": "^2.10.3",
    "@types/node-cron": "^3.0.11",
    "@types/pidusage": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "tsx": "^4.1.1",
    "tsc-alias": "^1.8.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@testcontainers/postgresql": "^10.3.2",
    "@testcontainers/redis": "^10.3.2",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.4",
    "ws": "^8.14.2",
    "@types/ws": "^8.5.10",
    "artillery": "^2.0.5",
    "puppeteer": "^21.5.2",
    "@types/puppeteer": "^5.4.7",
    "faker": "^5.5.3",
    "@faker-js/faker": "^8.3.1",
    "form-data": "^4.0.0",
    "@types/form-data": "^2.5.0",
    "playwright": "^1.40.1",
    "@playwright/test": "^1.40.1",
    "axe-core": "^4.8.3",
    "axe-playwright": "^1.2.3",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HKUDS/RAG-Anything.git",
    "directory": "api"
  },
  "bugs": {
    "url": "https://github.com/HKUDS/RAG-Anything/issues"
  },
  "homepage": "https://github.com/HKUDS/RAG-Anything#readme",
  "volta": {
    "node": "20.9.0",
    "npm": "10.1.0"
  }
}